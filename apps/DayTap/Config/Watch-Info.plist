<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    UIBackgroundModes=audio：录音会话活跃期间，App 退后台（按表冠回表盘、切走）继续录。
	    这是 #5「无感录音」的前置：谈话中开录后不需要停留在这个 App。
	    刻意不用延长运行会话（WKExtendedRuntimeSession 的类型对不上、滥用有审核风险）；
	    本 App 为个人开发版，audio 后台模式 + 活跃 AVAudioSession 是官方文档与
	    Just Press Record / Wave 等先例采用的标准做法。
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>DayTab</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DayTab</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>MinimumOSVersion</key>
	<string>$(WATCHOS_DEPLOYMENT_TARGET)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DayTap 只用麦克风在这只手表上录音。点停止后，音频会传到你配对的 iPhone。手表不会把录音发给得到。</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.guanhongli.daytap</string>
</dict>
</plist>
